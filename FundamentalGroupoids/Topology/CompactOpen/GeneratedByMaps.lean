module

public import FundamentalGroupoids.Topology.Convenient.GeneratedBy.Basic
public import Mathlib.Topology.Convenient.HomSpace

/-!
# Generated maps and ordinary compact-open maps

Every ordinary continuous map gives a generated map, without any hypothesis on
its source. If the original source is generated by the probes, this conversion is
a value-preserving equivalence with ordinary continuous maps.

The topology on generated maps is initial for precomposition by probes. Applied
to families of ordinary continuous maps, this gives a coordinatewise continuity
criterion, and in particular continuity of the conversion from the ordinary
compact-open topology. The index, probes, source, and target have independent
universes, and the topologies of the original source and target are retained.

The topology induced on the same ordinary continuous-map carrier by this conversion
is also characterized without a generated-source hypothesis. For a generated source,
the carrier equivalence is a homeomorphism from generated maps to that induced
topology. No continuity from generated maps to the unrefined ordinary compact-open
topology is asserted.

If the probes are locally compact and their ordinary pairwise products are
generated, an ordinary product of a probe with an original generated source is
generated. This relative product result uses the stock generated-map currying
equivalence and the conversion API above, not a new currying construction.

## References

The generated-map carrier and topology come from Mathlib's [generated maps](https://github.com/leanprover-community/mathlib4/blob/83abb3e776bdefcbc447a1e44d0debe4010039e5/Mathlib/Topology/Convenient/ContinuousMapGeneratedBy.lean),
by Joël Riou. The relative-product argument uses the currying equivalence in his
[generated mapping spaces](https://github.com/leanprover-community/mathlib4/blob/83abb3e776bdefcbc447a1e44d0debe4010039e5/Mathlib/Topology/Convenient/HomSpace.lean) formalization. Both depend on the
[generated-by topology](https://github.com/leanprover-community/mathlib4/blob/83abb3e776bdefcbc447a1e44d0debe4010039e5/Mathlib/Topology/Convenient/GeneratedBy.lean) formalization of Joël Riou, Dagur Asgeirsson and Ben Eltschig.
-/

@[expose] public section

noncomputable section

universe t u v w z

namespace Topology.ContinuousMapGeneratedBy

variable {ι : Type t} (Φ : ι → Type u) [tΦ : ∀ i, TopologicalSpace (Φ i)]
variable {A : Type v} {Y : Type w} [tA : TopologicalSpace A] [tY : TopologicalSpace Y]

/-- Regard an ordinary continuous map as a generated map, preserving its function. -/
def ofContinuousMap (f : @ContinuousMap A Y tA tY) :
    ContinuousMapGeneratedBy Φ A Y := by
  have hf : Topology.ContinuousGeneratedBy Φ (f : A → Y) :=
    @Continuous.continuousGeneratedBy ι Φ tΦ A tA Y tY (f : A → Y) f.continuous
  exact ⟨(f : A → Y), hf⟩

/-- The conversion preserves the whole underlying function. -/
@[simp]
theorem coe_ofContinuousMap (f : @ContinuousMap A Y tA tY) :
    ⇑(@ofContinuousMap ι Φ tΦ A Y tA tY f) = (f : A → Y) := rfl

theorem ofContinuousMap_apply (f : @ContinuousMap A Y tA tY) (a : A) :
    @ofContinuousMap ι Φ tΦ A Y tA tY f a = f a := rfl

/-- A generated map on an original generated source is an ordinary continuous map.
Continuity follows from the public probe-precomposition criterion. -/
def toContinuousMap [hA : IsGeneratedBy Φ A] (f : ContinuousMapGeneratedBy Φ A Y) :
    @ContinuousMap A Y tA tY := by
  refine ⟨f, (@IsGeneratedBy.continuous_iff ι Φ tΦ A tA Y tY hA (f : A → Y)).2 ?_⟩
  intro i p
  rw [← @ContinuousMapGeneratedBy.precomp_apply ι Φ tΦ A tA Y tY i p f]
  exact (@ContinuousMapGeneratedBy.precomp ι Φ tΦ A tA Y tY i p f).continuous

/-- The reverse conversion preserves the whole underlying function. -/
@[simp]
theorem coe_toContinuousMap [hA : IsGeneratedBy Φ A] (f : ContinuousMapGeneratedBy Φ A Y) :
    ⇑(@toContinuousMap ι Φ tΦ A Y tA tY hA f) = (f : A → Y) := rfl

theorem toContinuousMap_apply [hA : IsGeneratedBy Φ A]
    (f : ContinuousMapGeneratedBy Φ A Y) (a : A) :
    @toContinuousMap ι Φ tΦ A Y tA tY hA f a = f a := rfl

/-- Converting back from an ordinary map recovers the generated map. -/
@[simp]
theorem ofContinuousMap_toContinuousMap [hA : IsGeneratedBy Φ A]
    (f : ContinuousMapGeneratedBy Φ A Y) :
    @ofContinuousMap ι Φ tΦ A Y tA tY
        (@toContinuousMap ι Φ tΦ A Y tA tY hA f) = f := by
  apply DFunLike.ext
  intro a
  rfl

/-- Converting back from a generated map recovers the ordinary continuous map. -/
@[simp]
theorem toContinuousMap_ofContinuousMap [hA : IsGeneratedBy Φ A]
    (f : @ContinuousMap A Y tA tY) :
    @toContinuousMap ι Φ tΦ A Y tA tY hA
        (@ofContinuousMap ι Φ tΦ A Y tA tY f) = f := by
  apply DFunLike.ext
  intro a
  rfl

/-- The value-preserving equivalence between generated maps and ordinary continuous
maps from an original generated source. This is a carrier equivalence, not an
assertion about the ordinary compact-open topology. -/
def equivContinuousMap [hA : IsGeneratedBy Φ A] :
    ContinuousMapGeneratedBy Φ A Y ≃ @ContinuousMap A Y tA tY where
  toFun := @toContinuousMap ι Φ tΦ A Y tA tY hA
  invFun := @ofContinuousMap ι Φ tΦ A Y tA tY
  left_inv := @ofContinuousMap_toContinuousMap ι Φ tΦ A Y tA tY hA
  right_inv := @toContinuousMap_ofContinuousMap ι Φ tΦ A Y tA tY hA

@[simp]
theorem equivContinuousMap_apply [hA : IsGeneratedBy Φ A]
    (f : ContinuousMapGeneratedBy Φ A Y) :
    @equivContinuousMap ι Φ tΦ A Y tA tY hA f =
      @toContinuousMap ι Φ tΦ A Y tA tY hA f := rfl

@[simp]
theorem equivContinuousMap_symm_apply [hA : IsGeneratedBy Φ A]
    (f : @ContinuousMap A Y tA tY) :
    (@equivContinuousMap ι Φ tΦ A Y tA tY hA).symm f =
      @ofContinuousMap ι Φ tΦ A Y tA tY f := rfl

/-- Probe precomposition commutes with the conversion of ordinary continuous maps. -/
@[simp]
theorem precomp_ofContinuousMap {i : ι} (p : C(Φ i, A))
    (f : @ContinuousMap A Y tA tY) :
    @ContinuousMapGeneratedBy.precomp ι Φ tΦ A tA Y tY i p
        (@ofContinuousMap ι Φ tΦ A Y tA tY f) = f.comp p := by
  apply DFunLike.ext
  intro x
  exact congrFun (@ContinuousMapGeneratedBy.precomp_apply ι Φ tΦ A tA Y tY i p
    (@ofContinuousMap ι Φ tΦ A Y tA tY f)) x

/-- A family of ordinary continuous maps is continuous into the generated-map
space exactly when each probe-precomposition coordinate is continuous into the
ordinary compact-open space. No generatedness or local compactness is needed. -/
theorem continuous_ofContinuousMap_iff
    {S : Type z} [tS : TopologicalSpace S]
    (φ : S → @ContinuousMap A Y tA tY) :
    @Continuous S (ContinuousMapGeneratedBy Φ A Y) tS
        (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
        (fun s => @ofContinuousMap ι Φ tΦ A Y tA tY (φ s)) ↔
      ∀ (i : ι) (p : @ContinuousMap (Φ i) A (tΦ i) tA),
        @Continuous S (@ContinuousMap (Φ i) Y (tΦ i) tY) tS
          (@ContinuousMap.compactOpen (Φ i) Y (tΦ i) tY)
          (fun s => (φ s).comp p) := by
  simpa only [Function.comp_def,
    precomp_ofContinuousMap (ι := ι) Φ (tΦ := tΦ)
      (A := A) (Y := Y) (tA := tA) (tY := tY)] using
    (@ContinuousMapGeneratedBy.continuous_iff ι Φ tΦ A tA Y tY S tS
      (fun s : S => @ofContinuousMap ι Φ tΦ A Y tA tY (φ s)))

/-- The conversion from the ordinary compact-open topology to the generated-map
space is continuous for every original source and target. -/
theorem continuous_ofContinuousMap :
    @Continuous (@ContinuousMap A Y tA tY) (ContinuousMapGeneratedBy Φ A Y)
      (@ContinuousMap.compactOpen A Y tA tY)
      (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
      (@ofContinuousMap ι Φ tΦ A Y tA tY) := by
  apply (continuous_ofContinuousMap_iff (ι := ι) Φ (tΦ := tΦ)
    (A := A) (Y := Y) (tA := tA) (tY := tY)
    (S := @ContinuousMap A Y tA tY)
    (tS := @ContinuousMap.compactOpen A Y tA tY)
    (_root_.id : @ContinuousMap A Y tA tY → @ContinuousMap A Y tA tY)).2
  intro i p
  exact @ContinuousMap.continuous_precomp (Φ i) A Y (tΦ i) tA tY p

/-- The topology on the ordinary continuous-map carrier induced from generated maps
by the value-preserving conversion. This definition does not change the topologies
of the original source or target, and is not installed as an instance. -/
abbrev continuousMapInducedTopology : TopologicalSpace (@ContinuousMap A Y tA tY) :=
  TopologicalSpace.induced
    (@ofContinuousMap ι Φ tΦ A Y tA tY)
    (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))

/-- The universal continuity criterion for the topology induced along conversion to
generated maps. This connection does not require a generated source. -/
theorem continuous_inducedTopology_iff
    {S : Type z} [tS : TopologicalSpace S]
    (φ : S → @ContinuousMap A Y tA tY) :
    @Continuous S (@ContinuousMap A Y tA tY) tS
        (@continuousMapInducedTopology ι Φ tΦ A Y tA tY) φ ↔
      @Continuous S (ContinuousMapGeneratedBy Φ A Y) tS
        (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
        (fun s => @ofContinuousMap ι Φ tΦ A Y tA tY (φ s)) := by
  let tRaw : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y) := inferInstance
  exact _root_.continuous_induced_rng (t₁ := tS) (t₂ := tRaw)
    (f := @ofContinuousMap ι Φ tΦ A Y tA tY) (g := φ)

/-- The induced topology on ordinary continuous maps is initial for all ordinary
compact-open probe-precomposition coordinates, for every source space. -/
theorem continuous_inducedTopology_iff_precomp
    {S : Type z} [tS : TopologicalSpace S]
    (φ : S → @ContinuousMap A Y tA tY) :
    @Continuous S (@ContinuousMap A Y tA tY) tS
        (@continuousMapInducedTopology ι Φ tΦ A Y tA tY) φ ↔
      ∀ (i : ι) (p : @ContinuousMap (Φ i) A (tΦ i) tA),
        @Continuous S (@ContinuousMap (Φ i) Y (tΦ i) tY) tS
          (@ContinuousMap.compactOpen (Φ i) Y (tΦ i) tY)
          (fun s => (φ s).comp p) := by
  exact (continuous_inducedTopology_iff (ι := ι) Φ (tΦ := tΦ)
    (A := A) (Y := Y) (tA := tA) (tY := tY)
    (S := S) (tS := tS) φ).trans
      (continuous_ofContinuousMap_iff (ι := ι) Φ (tΦ := tΦ)
        (A := A) (Y := Y) (tA := tA) (tY := tY)
        (S := S) (tS := tS) φ)

/-- The identity from ordinary compact-open to the topology induced from generated
maps is continuous, without any local compactness or generatedness hypothesis. -/
theorem continuous_id_inducedTopology :
    @Continuous (@ContinuousMap A Y tA tY) (@ContinuousMap A Y tA tY)
      (@ContinuousMap.compactOpen A Y tA tY)
      (@continuousMapInducedTopology ι Φ tΦ A Y tA tY) _root_.id := by
  exact (continuous_inducedTopology_iff (ι := ι) Φ (tΦ := tΦ)
    (A := A) (Y := Y) (tA := tA) (tY := tY)
    (S := @ContinuousMap A Y tA tY)
    (tS := @ContinuousMap.compactOpen A Y tA tY)
    (_root_.id : @ContinuousMap A Y tA tY → @ContinuousMap A Y tA tY)).2
      (continuous_ofContinuousMap (ι := ι) Φ (tΦ := tΦ)
        (A := A) (Y := Y) (tA := tA) (tY := tY))

/-- Generated maps from an original generated source are homeomorphic to the ordinary
continuous-map carrier equipped with the topology induced by `ofContinuousMap`.
The homeomorphism and its inverse preserve the entire underlying function. -/
def homeomorphInducedContinuousMap [hA : IsGeneratedBy Φ A] :
    @Homeomorph (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
      (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
      (@continuousMapInducedTopology ι Φ tΦ A Y tA tY) := by
  let tRaw : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y) := inferInstance
  let tInd : TopologicalSpace (@ContinuousMap A Y tA tY) :=
    @continuousMapInducedTopology ι Φ tΦ A Y tA tY
  refine @Homeomorph.mk (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
    tRaw tInd
    (@equivContinuousMap ι Φ tΦ A Y tA tY hA) ?_ ?_
  · change @Continuous (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
      tRaw tInd (@toContinuousMap ι Φ tΦ A Y tA tY hA)
    have h :
        @Continuous (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
            tRaw tInd
            (@toContinuousMap ι Φ tΦ A Y tA tY hA) ↔
          @Continuous (ContinuousMapGeneratedBy Φ A Y) (ContinuousMapGeneratedBy Φ A Y)
            tRaw tRaw
            ((@ofContinuousMap ι Φ tΦ A Y tA tY) ∘
              (@toContinuousMap ι Φ tΦ A Y tA tY hA)) :=
      _root_.continuous_induced_rng (t₁ := tRaw) (t₂ := tRaw)
        (f := @ofContinuousMap ι Φ tΦ A Y tA tY)
        (g := @toContinuousMap ι Φ tΦ A Y tA tY hA)
    apply h.2
    have hinv : (@ofContinuousMap ι Φ tΦ A Y tA tY) ∘
        (@toContinuousMap ι Φ tΦ A Y tA tY hA) =
        (_root_.id : ContinuousMapGeneratedBy Φ A Y → ContinuousMapGeneratedBy Φ A Y) := by
      funext f
      exact @ofContinuousMap_toContinuousMap ι Φ tΦ A Y tA tY hA f
    rw [hinv]
    exact @continuous_id (ContinuousMapGeneratedBy Φ A Y) tRaw
  · change @Continuous (@ContinuousMap A Y tA tY) (ContinuousMapGeneratedBy Φ A Y)
      tInd tRaw (@ofContinuousMap ι Φ tΦ A Y tA tY)
    have h :
        @Continuous (@ContinuousMap A Y tA tY) (@ContinuousMap A Y tA tY)
            tInd tInd _root_.id ↔
          @Continuous (@ContinuousMap A Y tA tY) (ContinuousMapGeneratedBy Φ A Y)
            tInd tRaw ((@ofContinuousMap ι Φ tΦ A Y tA tY) ∘ _root_.id) :=
      _root_.continuous_induced_rng (t₁ := tInd) (t₂ := tRaw)
        (f := @ofContinuousMap ι Φ tΦ A Y tA tY)
        (g := (_root_.id : @ContinuousMap A Y tA tY → @ContinuousMap A Y tA tY))
    exact h.1 (@continuous_id (@ContinuousMap A Y tA tY) tInd)

/-- The homeomorphism has exactly the ordinary continuous-map carrier equivalence. -/
theorem homeomorphInducedContinuousMap_toEquiv [hA : IsGeneratedBy Φ A] :
    @Homeomorph.toEquiv (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
        (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
        (@continuousMapInducedTopology ι Φ tΦ A Y tA tY)
        (@homeomorphInducedContinuousMap ι Φ tΦ A Y tA tY hA) =
      @equivContinuousMap ι Φ tΦ A Y tA tY hA := rfl

/-- The whole forward function is the ordinary continuous-map conversion. -/
theorem coe_homeomorphInducedContinuousMap [hA : IsGeneratedBy Φ A] :
    ⇑(@homeomorphInducedContinuousMap ι Φ tΦ A Y tA tY hA) =
      @toContinuousMap ι Φ tΦ A Y tA tY hA := rfl

@[simp]
theorem homeomorphInducedContinuousMap_apply [hA : IsGeneratedBy Φ A]
    (f : ContinuousMapGeneratedBy Φ A Y) :
    @homeomorphInducedContinuousMap ι Φ tΦ A Y tA tY hA f =
      @toContinuousMap ι Φ tΦ A Y tA tY hA f := rfl

/-- The forward homeomorphism retains every original value. -/
theorem homeomorphInducedContinuousMap_apply_apply [hA : IsGeneratedBy Φ A]
    (f : ContinuousMapGeneratedBy Φ A Y) (a : A) :
    @homeomorphInducedContinuousMap ι Φ tΦ A Y tA tY hA f a =
      f a := rfl

/-- The inverse homeomorphism is exactly conversion to generated maps. -/
@[simp]
theorem homeomorphInducedContinuousMap_symm_apply [hA : IsGeneratedBy Φ A]
    (f : @ContinuousMap A Y tA tY) :
    (@Homeomorph.symm (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
      (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
      (@continuousMapInducedTopology ι Φ tΦ A Y tA tY)
      (@homeomorphInducedContinuousMap ι Φ tΦ A Y tA tY hA)) f =
        @ofContinuousMap ι Φ tΦ A Y tA tY f := rfl

/-- The inverse homeomorphism retains every original value. -/
theorem homeomorphInducedContinuousMap_symm_apply_apply [hA : IsGeneratedBy Φ A]
    (f : @ContinuousMap A Y tA tY) (a : A) :
    (@Homeomorph.symm (ContinuousMapGeneratedBy Φ A Y) (@ContinuousMap A Y tA tY)
      (inferInstance : TopologicalSpace (ContinuousMapGeneratedBy Φ A Y))
      (@continuousMapInducedTopology ι Φ tΦ A Y tA tY)
      (@homeomorphInducedContinuousMap ι Φ tΦ A Y tA tY hA)) f a =
        f a := rfl

end Topology.ContinuousMapGeneratedBy

namespace Topology

variable {ι : Type t} (Φ : ι → Type u) [tΦ : ∀ i, TopologicalSpace (Φ i)]

-- Each original probe is generated by its own family. Refining its source
-- topology therefore does not change the continuity supplied by the generic API.
private theorem continuous_probe_to_generatedBy {B : Type v} [tB : TopologicalSpace B]
    {i : ι} (p : @ContinuousMap (Φ i) B (tΦ i) tB) :
    @Continuous (Φ i) B (tΦ i) (@TopologicalSpace.generatedBy ι Φ tΦ B tB) p := by
  have hprobe : @IsGeneratedBy ι Φ tΦ (Φ i) (tΦ i) := inferInstance
  have htop : @TopologicalSpace.generatedBy ι Φ tΦ (Φ i) (tΦ i) = tΦ i :=
    @IsGeneratedBy.generatedBy_eq ι Φ tΦ (Φ i) (tΦ i) hprobe
  have hp : @Continuous (Φ i) B
      (@TopologicalSpace.generatedBy ι Φ tΦ (Φ i) (tΦ i))
      (@TopologicalSpace.generatedBy ι Φ tΦ B tB) p :=
    @Continuous.generatedByTopology ι Φ tΦ (Φ i) (tΦ i) B tB
      (p : Φ i → B) p.continuous
  rwa [htop] at hp

variable {A : Type v} [tA : TopologicalSpace A]

-- Test arbitrary maps out of a probe product by the stock currying equivalence.
private theorem continuous_of_probe_prod
    [hLC : ∀ i, LocallyCompactSpace (Φ i)]
    [hPairs : ∀ i j, IsGeneratedBy Φ (Φ i × Φ j)] [hA : IsGeneratedBy Φ A]
    (i : ι) {Z : Type w} [tZ : TopologicalSpace Z]
    (g : Φ i × A → Z) (hg : Topology.ContinuousGeneratedBy Φ g) :
    Continuous g := by
  let r : ContinuousMapGeneratedBy Φ (Φ i × A) Z := ⟨g, hg⟩
  let tRawProbe : TopologicalSpace (ContinuousMapGeneratedBy Φ (Φ i) Z) := inferInstance
  let c : @ContinuousMap A (ContinuousMapGeneratedBy Φ (Φ i) Z) tA tRawProbe :=
    ContinuousMapGeneratedBy.toContinuousMap (ι := ι) Φ (tΦ := tΦ)
      (A := A) (Y := ContinuousMapGeneratedBy Φ (Φ i) Z)
      (tA := tA) (tY := tRawProbe) (hA := hA)
      ((@ContinuousMapGeneratedBy.curryEquiv ι Φ tΦ (Φ i) (tΦ i) A tA Z tZ hLC hPairs) r)
  have hp : @Continuous (ContinuousMapGeneratedBy Φ (Φ i) Z)
      (@ContinuousMap (Φ i) Z (tΦ i) tZ) tRawProbe
      (@ContinuousMap.compactOpen (Φ i) Z (tΦ i) tZ)
      (@ContinuousMapGeneratedBy.precomp ι Φ tΦ (Φ i) (tΦ i) Z tZ i
        (@ContinuousMap.id (Φ i) (tΦ i))) := by
    simpa only [Function.comp_id] using
      ((@ContinuousMapGeneratedBy.continuous_iff ι Φ tΦ (Φ i) (tΦ i) Z tZ
        (ContinuousMapGeneratedBy Φ (Φ i) Z) tRawProbe
        (_root_.id : ContinuousMapGeneratedBy Φ (Φ i) Z →
          ContinuousMapGeneratedBy Φ (Φ i) Z)).1
            (@continuous_id (ContinuousMapGeneratedBy Φ (Φ i) Z) tRawProbe) i
            (@ContinuousMap.id (Φ i) (tΦ i)))
  let F : @ContinuousMap A (@ContinuousMap (Φ i) Z (tΦ i) tZ) tA
      (@ContinuousMap.compactOpen (Φ i) Z (tΦ i) tZ) :=
    ⟨(@ContinuousMapGeneratedBy.precomp ι Φ tΦ (Φ i) (tΦ i) Z tZ i
        (@ContinuousMap.id (Φ i) (tΦ i))) ∘ c,
      @Continuous.comp A (ContinuousMapGeneratedBy Φ (Φ i) Z)
        (@ContinuousMap (Φ i) Z (tΦ i) tZ) tA tRawProbe
        (@ContinuousMap.compactOpen (Φ i) Z (tΦ i) tZ) c
        (@ContinuousMapGeneratedBy.precomp ι Φ tΦ (Φ i) (tΦ i) Z tZ i
          (@ContinuousMap.id (Φ i) (tΦ i))) hp c.continuous⟩
  have hF (a : A) (x : Φ i) : F a x = g (x, a) := by
    calc
      F a x = @ContinuousMapGeneratedBy.precomp ι Φ tΦ (Φ i) (tΦ i) Z tZ i
          (@ContinuousMap.id (Φ i) (tΦ i))
          ((@ContinuousMapGeneratedBy.curryEquiv ι Φ tΦ
            (Φ i) (tΦ i) A tA Z tZ hLC hPairs) r a) x := rfl
      _ = (@ContinuousMapGeneratedBy.curryEquiv ι Φ tΦ (Φ i) (tΦ i) A tA Z tZ hLC hPairs) r a x :=
        congrFun (@ContinuousMapGeneratedBy.precomp_apply ι Φ tΦ (Φ i) (tΦ i) Z tZ i
          (@ContinuousMap.id (Φ i) (tΦ i))
          ((@ContinuousMapGeneratedBy.curryEquiv ι Φ tΦ
            (Φ i) (tΦ i) A tA Z tZ hLC hPairs) r a)) x
      _ = r (x, a) :=
        @ContinuousMapGeneratedBy.curryEquiv_apply_apply ι Φ tΦ
          (Φ i) (tΦ i) A tA Z tZ hLC hPairs r x a
      _ = g (x, a) := rfl
  have hu : Continuous (Function.uncurry fun a x => F a x) :=
    @ContinuousMap.continuous_uncurry_of_continuous A (Φ i) Z tA (tΦ i) tZ (hLC i) F
  have hs := hu.comp (Homeomorph.prodComm (Φ i) A).continuous
  have hsame : (Function.uncurry fun a x => F a x) ∘
      (Homeomorph.prodComm (Φ i) A) = g := by
    funext p
    rw [Homeomorph.coe_prodComm]
    exact hF p.2 p.1
  rwa [hsame] at hs

/-- With locally compact probes and generated ordinary probe products, the ordinary
product of a probe with an original generated space is generated by the same family.
No local compactness of the original space or arbitrary-product generatedness is
assumed. -/
theorem IsGeneratedBy.probe_prod
    [hLC : ∀ i, LocallyCompactSpace (Φ i)]
    [hPairs : ∀ i j, IsGeneratedBy Φ (Φ i × Φ j)] [hA : IsGeneratedBy Φ A]
    (i : ι) : IsGeneratedBy Φ (Φ i × A) := by
  apply (@IsGeneratedBy.iff_le_generatedBy ι Φ tΦ (Φ i × A)
    (@instTopologicalSpaceProd (Φ i) A (tΦ i) tA)).2
  let tProd : TopologicalSpace (Φ i × A) :=
    @instTopologicalSpaceProd (Φ i) A (tΦ i) tA
  have hg : @Topology.ContinuousGeneratedBy ι Φ tΦ (Φ i × A) tProd
      (Φ i × A) (tProd.generatedBy Φ) _root_.id := by
    apply (@Topology.continuousGeneratedBy_def ι Φ tΦ (Φ i × A) tProd
      (Φ i × A) (tProd.generatedBy Φ) _root_.id).2
    intro j p
    exact continuous_probe_to_generatedBy (ι := ι) Φ (tΦ := tΦ)
      (B := Φ i × A) (tB := tProd) (i := j) p
  have hcont : @Continuous (Φ i × A) (Φ i × A) tProd (tProd.generatedBy Φ) _root_.id :=
    continuous_of_probe_prod (ι := ι) Φ (tΦ := tΦ) (A := A) (tA := tA)
      (hLC := hLC) (hPairs := hPairs) (hA := hA) i
      (Z := Φ i × A) (tZ := tProd.generatedBy Φ) _root_.id hg
  exact (continuous_id_iff_le (t := tProd) (t' := tProd.generatedBy Φ)).1 hcont

end Topology
