module

public import FundamentalGroupoids.Topology.Compactness.CompactlyGeneratedSpace
public import Mathlib.Topology.Convenient.OpenClosed

/-!
# Compact generation by a fixed universe of compact Hausdorff probes

The family `fun K : CompHaus.{v} => K` presents fixed-universe compact generation as
an instance of generation by an arbitrary family of spaces. The probe universe `v`
is independent of the universe `u` of the space being generated.

The closed-probe statement supplies the family hypothesis of
`IsClosed.isGeneratedBy` and `Topology.IsClosedEmbedding.isGeneratedBy`. It concerns
closed subspaces of the probes, not arbitrary subspaces of a generated space.
-/

@[expose] public section

universe u v

open Topology

/-- Fixed-universe compact generation is generation by the family of all compact
Hausdorff spaces in the probe universe, independently of the carrier universe. -/
theorem uCompactlyGeneratedSpace_iff_isGeneratedBy_compHaus
    (Y : Type u) [TopologicalSpace Y] :
    UCompactlyGeneratedSpace.{v} Y ↔
      IsGeneratedBy (fun K : CompHaus.{v} => K) Y := by
  constructor
  · intro h
    let := h
    apply (IsGeneratedBy.iff_le_generatedBy (X := fun K : CompHaus.{v} => K)).2
    intro U hU
    apply UCompactlyGeneratedSpace.isOpen
    intro K f
    exact (WithGeneratedByTopology.isOpen_iff
      (X := fun K : CompHaus.{v} => K) (Y := Y) (U := U)).1 hU f
  · intro h
    let := h
    apply uCompactlyGeneratedSpace_of_isOpen
    intro U hU
    exact (IsGeneratedBy.isOpen_iff (X := fun K : CompHaus.{v} => K)).2
      fun {_} f => hU _ f

/-- The existing compactly generated topology is the existing topology generated
by the compact Hausdorff family in the same fixed probe universe. -/
theorem TopologicalSpace.compactlyGenerated_eq_generatedBy_compHaus
    (Y : Type u) [tY : TopologicalSpace Y] :
    TopologicalSpace.compactlyGenerated.{v} Y =
      tY.generatedBy (fun K : CompHaus.{v} => K) := by
  apply le_antisymm
  · let counit := ContinuousMap.compactlyGeneratedCounit.{v} Y
    let tCG : TopologicalSpace Y := TopologicalSpace.compactlyGenerated.{v} Y
    let : TopologicalSpace Y := tCG
    intro U hU
    apply UCompactlyGeneratedSpace.isOpen
    intro K f
    exact (WithGeneratedByTopology.isOpen_iff
      (X := fun K : CompHaus.{v} => K) (Y := Y) (tY := tY) (U := U)).1 hU
      (@ContinuousMap.comp K Y Y inferInstance tCG tY counit f)
  · intro U hU
    apply (WithGeneratedByTopology.isOpen_iff
      (X := fun K : CompHaus.{v} => K) (Y := Y) (U := U)).2
    intro K f
    have hf :
        @Continuous K Y inferInstance (TopologicalSpace.compactlyGenerated.{v} Y) f :=
      (continuous_to_compactlyGenerated_iff (tX := tY) f).2 f.continuous
    rw [continuous_def] at hf
    exact hf U hU

/-- Every closed subspace of a compact Hausdorff probe is generated by the same
fixed-universe family. This is precisely the closed-probe hypothesis of
`IsClosed.isGeneratedBy` and `Topology.IsClosedEmbedding.isGeneratedBy`. -/
theorem Topology.isGeneratedBy_compHaus_closeds :
    ∀ (K : CompHaus.{v}) (F : TopologicalSpace.Closeds K),
      IsGeneratedBy (fun K : CompHaus.{v} => K) F := by
  intro K F
  let : CompactSpace F := isCompact_iff_compactSpace.mp F.isClosed.isCompact
  exact (uCompactlyGeneratedSpace_iff_isGeneratedBy_compHaus (CompHaus.of F)).1 inferInstance
