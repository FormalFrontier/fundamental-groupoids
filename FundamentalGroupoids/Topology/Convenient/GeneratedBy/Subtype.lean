module

public import FundamentalGroupoids.Topology.Convenient.GeneratedBy.Basic
public import Mathlib.Topology.Convenient.OpenClosed

/-!
# Generated-by refinement and arbitrary subspaces

Fix a family of probes `X`. A subset `A` of an original space `Y` has two relevant
subspace topologies: its original one, and that of the counit-preimage of `A` in
`WithGeneratedByTopology X Y`. After refining both subspaces by the same family,
there are canonical continuous maps in both directions. No closedness, separation,
compactness, or inhabitance assumption is needed for these maps.

The index, probe, and original carrier universes are independent. The maps use the
stock generated-by refinement, its mapping-out property, and subtype restrictions.
Their point characteristics express the canonical identification of original points.

The canonical maps are inverse and give a homeomorphism natural in continuous
ambient maps preserving the subsets. Closed heredity uses the stock condition that
each closed subspace of a probe is generated by the same family; for closed subsets,
the outer refinement on the counit-preimage can then be omitted.
-/

@[expose] public section

noncomputable section

universe t u v w

open Topology

namespace Topology.WithGeneratedByTopology

variable {ι : Type t} (X : ι → Type u) [∀ i, TopologicalSpace (X i)]

variable {Y : Type v} [TopologicalSpace Y] {Z : Type w} [TopologicalSpace Z]

/-- Restrict the stock counit to the preimage of the original subset. -/
def subtypeCounitContinuousMap (A : Set Y) :
    C((equiv (X := X) (Y := Y)) ⁻¹' A, A) :=
  (counitContinuousMap X Y).restrictPreimage A

@[simp]
theorem subtypeCounitContinuousMap_apply (A : Set Y)
    (a : (equiv (X := X) (Y := Y)) ⁻¹' A) :
    (subtypeCounitContinuousMap X A a).val = equiv a.val := rfl

/-- Refine the original inclusion and corestrict it to the counit-preimage.
This is the intermediate comparison before refining its target once more. -/
def subtypeComparisonContinuousMap (A : Set Y) :
    C(WithGeneratedByTopology X A, (equiv (X := X) (Y := Y)) ⁻¹' A) := by
  let f : C(WithGeneratedByTopology X A, WithGeneratedByTopology X Y) :=
    ((ContinuousMap.subtypeVal A).continuous.continuousGeneratedBy (X := X)).continuousMap
  have hf (a : WithGeneratedByTopology X A) : equiv (f a) ∈ A := by
    rw [show equiv (f a) = (equiv a).val from by
      simp only [f, ContinuousGeneratedBy.continuousMap_coe, Function.comp_apply,
        Equiv.apply_symm_apply]
      rfl]
    exact (equiv a).property
  exact ⟨fun a => ⟨f a, hf a⟩, f.continuous.subtype_mk hf⟩

@[simp]
theorem subtypeComparisonContinuousMap_apply (A : Set Y)
    (a : WithGeneratedByTopology X A) :
    (subtypeComparisonContinuousMap X A a).val =
      (equiv (X := X) (Y := Y)).symm (equiv a).val := by
  change ((ContinuousMap.subtypeVal A).continuous.continuousGeneratedBy
    (X := X)).continuousMap a = _
  rw [ContinuousGeneratedBy.continuousMap_coe]
  rfl

/-- The canonical forward map between the two refined subspaces.
The source is already generated, so the intermediate comparison lifts to the
refinement of the counit-preimage without any hypothesis on the subset. -/
def subtypeForward (A : Set Y) :
    C(WithGeneratedByTopology X A,
      WithGeneratedByTopology X ((equiv (X := X) (Y := Y)) ⁻¹' A)) :=
  ⟨(equiv (X := X) (Y := (equiv (X := X) (Y := Y)) ⁻¹' A)).symm ∘
      subtypeComparisonContinuousMap X A,
    (IsGeneratedBy.equiv_symm_comp_continuous_iff X
      (subtypeComparisonContinuousMap X A)).2
        (subtypeComparisonContinuousMap X A).continuous⟩

/-- The canonical backward map: rerefine the restricted counit. -/
def subtypeBackward (A : Set Y) :
    C(WithGeneratedByTopology X ((equiv (X := X) (Y := Y)) ⁻¹' A),
      WithGeneratedByTopology X A) :=
  ((subtypeCounitContinuousMap X A).continuous.continuousGeneratedBy
    (X := X)).continuousMap

/-- The forward map preserves the canonical point of the refined ambient space. -/
@[simp]
theorem subtypeForward_apply (A : Set Y) (a : WithGeneratedByTopology X A) :
    (equiv (X := X) (Y := (equiv (X := X) (Y := Y)) ⁻¹' A)
      (subtypeForward X A a)).val =
        (equiv (X := X) (Y := Y)).symm (equiv a).val := by
  simpa only [subtypeForward, ContinuousMap.coe_mk, Function.comp_apply,
    Equiv.apply_symm_apply] using
    subtypeComparisonContinuousMap_apply X A a

/-- The backward map preserves the original point in `Y`. -/
@[simp]
theorem subtypeBackward_apply (A : Set Y)
    (a : WithGeneratedByTopology X ((equiv (X := X) (Y := Y)) ⁻¹' A)) :
    (equiv (subtypeBackward X A a)).val =
      equiv (equiv (X := X) (Y := (equiv (X := X) (Y := Y)) ⁻¹' A) a).val := by
  simp only [subtypeBackward, ContinuousGeneratedBy.continuousMap_coe,
    Function.comp_apply, Equiv.apply_symm_apply, subtypeCounitContinuousMap_apply]

/-- The forward map also preserves the original point in `Y`. -/
theorem subtypeForward_original_point (A : Set Y) (a : WithGeneratedByTopology X A) :
    equiv (equiv (X := X) (Y := (equiv (X := X) (Y := Y)) ⁻¹' A)
      (subtypeForward X A a)).val = (equiv a).val := by
  rw [subtypeForward_apply, Equiv.apply_symm_apply]

/-- Restrict a continuous map to subsets it maps into one another. -/
def subtypeMapContinuousMap (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (h : Set.MapsTo f A B) : C(A, B) :=
  (f.restrictPreimage B).comp (ContinuousMap.inclusion (show A ⊆ f ⁻¹' B from h))

@[simp]
theorem subtypeMapContinuousMap_apply (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (h : Set.MapsTo f A B) (a : A) :
    (subtypeMapContinuousMap f h a).val = f a.val := rfl

/-- Restrict the stock refinement of a continuous map to the two counit-preimages. -/
def refinedSubtypeMapContinuousMap (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (h : Set.MapsTo f A B) :
    C((equiv (X := X) (Y := Y)) ⁻¹' A, (equiv (X := X) (Y := Z)) ⁻¹' B) := by
  let g : C(WithGeneratedByTopology X Y, WithGeneratedByTopology X Z) :=
    (f.continuous.continuousGeneratedBy (X := X)).continuousMap
  have hg : (equiv (X := X) (Y := Y)) ⁻¹' A ⊆
      g ⁻¹' ((equiv (X := X) (Y := Z)) ⁻¹' B) := by
    intro a ha
    change equiv (g a) ∈ B
    rw [show equiv (g a) = f (equiv a) from by
      simp only [g, ContinuousGeneratedBy.continuousMap_coe, Function.comp_apply,
        Equiv.apply_symm_apply]]
    exact h ha
  exact (g.restrictPreimage ((equiv (X := X) (Y := Z)) ⁻¹' B)).comp
    (ContinuousMap.inclusion hg)

@[simp]
theorem refinedSubtypeMapContinuousMap_apply (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (h : Set.MapsTo f A B) (a : (equiv (X := X) (Y := Y)) ⁻¹' A) :
    (refinedSubtypeMapContinuousMap X f h a).val =
      (f.continuous.continuousGeneratedBy (X := X)).continuousMap a.val := rfl

/-- The canonical backward map is a left inverse of the forward map. -/
theorem subtypeBackward_comp_subtypeForward (A : Set Y) :
    (subtypeBackward X A).comp (subtypeForward X A) =
      ContinuousMap.id (WithGeneratedByTopology X A) := by
  apply ContinuousMap.ext
  intro a
  apply (equiv (X := X) (Y := A)).injective
  apply Subtype.ext
  exact (subtypeBackward_apply X A (subtypeForward X A a)).trans
    (subtypeForward_original_point X A a)

/-- The canonical forward map is a left inverse of the backward map. -/
theorem subtypeForward_comp_subtypeBackward (A : Set Y) :
    (subtypeForward X A).comp (subtypeBackward X A) =
      ContinuousMap.id
        (WithGeneratedByTopology X ((equiv (X := X) (Y := Y)) ⁻¹' A)) := by
  apply ContinuousMap.ext
  intro a
  apply (equiv (X := X) (Y := (equiv (X := X) (Y := Y)) ⁻¹' A)).injective
  apply Subtype.ext
  rw [ContinuousMap.comp_apply, ContinuousMap.id_apply, subtypeForward_apply]
  apply (equiv (X := X) (Y := Y)).injective
  rw [Equiv.apply_symm_apply]
  exact subtypeBackward_apply X A a

/-- The canonical double-refinement homeomorphism for an arbitrary subset of an
arbitrary original space. -/
def subtypeHomeomorph (A : Set Y) :
    WithGeneratedByTopology X A ≃ₜ
      WithGeneratedByTopology X ((equiv (X := X) (Y := Y)) ⁻¹' A) := by
  exact
    { toEquiv :=
        { toFun := subtypeForward X A
          invFun := subtypeBackward X A
          left_inv := fun a =>
            DFunLike.congr_fun (subtypeBackward_comp_subtypeForward X A) a
          right_inv := fun a =>
            DFunLike.congr_fun (subtypeForward_comp_subtypeBackward X A) a }
      continuous_toFun := (subtypeForward X A).continuous
      continuous_invFun := (subtypeBackward X A).continuous }

/-- The homeomorphism has the canonical forward continuous map. -/
theorem subtypeHomeomorph_toContinuousMap (A : Set Y) :
    toContinuousMap (subtypeHomeomorph X A) = subtypeForward X A := by
  rfl

/-- The inverse homeomorphism has the canonical backward continuous map. -/
theorem subtypeHomeomorph_symm_toContinuousMap (A : Set Y) :
    toContinuousMap ((subtypeHomeomorph X A).symm) = subtypeBackward X A := by
  rfl

/-- Naturality of the canonical forward map for any continuous ambient map preserving
the indicated subsets. -/
theorem subtypeForward_naturality (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (h : Set.MapsTo f A B) :
    (subtypeForward X B).comp
        ((subtypeMapContinuousMap f h).continuous.continuousGeneratedBy
          (X := X)).continuousMap =
      ((refinedSubtypeMapContinuousMap X f h).continuous.continuousGeneratedBy
        (X := X)).continuousMap.comp (subtypeForward X A) := by
  apply ContinuousMap.ext
  intro a
  apply (equiv (X := X) (Y := (equiv (X := X) (Y := Z)) ⁻¹' B)).injective
  apply Subtype.ext
  simp only [ContinuousMap.comp_apply, subtypeForward_apply,
    ContinuousGeneratedBy.continuousMap_coe, Function.comp_apply,
    Equiv.apply_symm_apply, subtypeMapContinuousMap_apply,
    refinedSubtypeMapContinuousMap_apply]

/-- The naturality square of the canonical homeomorphism, with the same probe family
on every corner. -/
theorem subtypeHomeomorph_naturality (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (h : Set.MapsTo f A B) :
    (toContinuousMap (subtypeHomeomorph X B)).comp
        ((subtypeMapContinuousMap f h).continuous.continuousGeneratedBy
          (X := X)).continuousMap =
      ((refinedSubtypeMapContinuousMap X f h).continuous.continuousGeneratedBy
        (X := X)).continuousMap.comp (toContinuousMap (subtypeHomeomorph X A)) := by
  simpa only [subtypeHomeomorph_toContinuousMap] using subtypeForward_naturality X f h

section Closed

/-- Under closed-probe stability, the counit-preimage of a closed original subset is
generated without a further refinement. -/
theorem isGeneratedBy_closedCounitPreimage
    [∀ (i : ι) (F : TopologicalSpace.Closeds (X i)), IsGeneratedBy X F]
    (A : Set Y) (hA : IsClosed A) :
    IsGeneratedBy X ((equiv (X := X) (Y := Y)) ⁻¹' A) := by
  have hpre : IsClosed ((equiv (X := X) (Y := Y)) ⁻¹' A) :=
    hA.preimage (counitContinuousMap X Y).continuous
  exact hpre.isGeneratedBy

/-- The closed-subset specialization drops the outer refinement on the subspace of
the refined ambient space. -/
def closedSubtypeHomeomorph
    [∀ (i : ι) (F : TopologicalSpace.Closeds (X i)), IsGeneratedBy X F]
    (A : Set Y) (hA : IsClosed A) :
    WithGeneratedByTopology X A ≃ₜ (equiv (X := X) (Y := Y)) ⁻¹' A := by
  letI := isGeneratedBy_closedCounitPreimage X A hA
  exact (subtypeHomeomorph X A).trans (IsGeneratedBy.homeomorph (X := X))

/-- The closed comparison has the intermediate comparison as its continuous map. -/
theorem closedSubtypeHomeomorph_toContinuousMap
    [∀ (i : ι) (F : TopologicalSpace.Closeds (X i)), IsGeneratedBy X F]
    (A : Set Y) (hA : IsClosed A) :
    toContinuousMap (closedSubtypeHomeomorph X A hA) =
      subtypeComparisonContinuousMap X A := by
  apply ContinuousMap.ext
  intro a
  apply Subtype.ext
  change (equiv (X := X) (Y := (equiv (X := X) (Y := Y)) ⁻¹' A)
    (subtypeForward X A a)).val = (subtypeComparisonContinuousMap X A a).val
  rw [subtypeForward_apply, subtypeComparisonContinuousMap_apply]

/-- The inverse closed comparison preserves original points. -/
theorem closedSubtypeHomeomorph_symm_apply
    [∀ (i : ι) (F : TopologicalSpace.Closeds (X i)), IsGeneratedBy X F]
    (A : Set Y) (hA : IsClosed A)
    (a : (equiv (X := X) (Y := Y)) ⁻¹' A) :
    (equiv ((closedSubtypeHomeomorph X A hA).symm a)).val = equiv a.val := by
  have h : subtypeComparisonContinuousMap X A
      ((closedSubtypeHomeomorph X A hA).symm a) = a := by
    rw [← closedSubtypeHomeomorph_toContinuousMap X A hA]
    exact (closedSubtypeHomeomorph X A hA).apply_symm_apply a
  simpa only [subtypeComparisonContinuousMap_apply, Equiv.apply_symm_apply] using
    congrArg (fun b : (equiv (X := X) (Y := Y)) ⁻¹' A => equiv b.val) h

/-- Naturality of the closed comparison for continuous maps between original spaces
and their closed subsets. -/
theorem closedSubtypeHomeomorph_naturality
    [∀ (i : ι) (F : TopologicalSpace.Closeds (X i)), IsGeneratedBy X F]
    (f : C(Y, Z)) {A : Set Y} {B : Set Z}
    (hA : IsClosed A) (hB : IsClosed B) (h : Set.MapsTo f A B) :
    (toContinuousMap (closedSubtypeHomeomorph X B hB)).comp
        ((subtypeMapContinuousMap f h).continuous.continuousGeneratedBy
          (X := X)).continuousMap =
      (refinedSubtypeMapContinuousMap X f h).comp
        (toContinuousMap (closedSubtypeHomeomorph X A hA)) := by
  rw [closedSubtypeHomeomorph_toContinuousMap, closedSubtypeHomeomorph_toContinuousMap]
  apply ContinuousMap.ext
  intro a
  apply Subtype.ext
  simp only [ContinuousMap.comp_apply, subtypeComparisonContinuousMap_apply,
    ContinuousGeneratedBy.continuousMap_coe, Function.comp_apply,
    Equiv.apply_symm_apply, subtypeMapContinuousMap_apply,
    refinedSubtypeMapContinuousMap_apply]

end Closed

end Topology.WithGeneratedByTopology
