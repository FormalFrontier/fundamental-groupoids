module

public import FundamentalGroupoids.Topology.Category.TopCat.Based.Universe
public import FundamentalGroupoids.Topology.Homotopy.CompactlyGenerated

/-!
# The based counit of compactly generated refinement

The continuous identity from the CompHaus-test topology to the original topology
preserves every selected point. `BasedTopCat.compactlyGeneratedCounitULift`
regards it as a based morphism after ordinary `ULift` of both original spaces.
`BasedTopCat.compactlyGeneratedCounitPostcomp` is its postcomposition map on
whole based-homotopy hom-sets, with homotopies relative to the source point.
For a source generated by the fixed probe universe,
`BasedTopCat.compactlyGeneratedCounitEquiv` is the resulting equivalence. Its
forward map is the counit on every class, and its inverse sends every original
based representative to its continuous lift into the refined target.
The forward comparison is natural for arbitrary source and target maps; the
inverse comparison requires generation only of the original source spaces.

The probe universe is fixed independently of the carrier universes. The optional
carrier enlargement `w` gives the common level `max w u v`; taking `w = 0` gives
`max u v` for original carrier levels `u` and `v`, without resizing the probes.
The topology on the original target is refined before either carrier is lifted. No comparison
between refinement of a lift and lifting a refinement is used. The source and
target need not be separated, and their selected points need not be closed.
The map on hom-sets exists for every source; lifting an original representative
uses only `UCompactlyGeneratedSpace` for that original source.

## References

* Mathlib's CompHaus-test topology and its source-test continuity API, due to
  Dagur Asgeirsson and Etienne Marion.
* The continuous counit and map-lifting API in
  `FundamentalGroupoids.Topology.Compactness.CompactlyGeneratedSpace`.
* J. P. May, *A Concise Course in Algebraic Topology*, Chapter 5 §§1–2,
  pp. 39–40, for compact-Hausdorff tests. May's weak-Hausdorff convention is not
  imposed here.
-/

@[expose] public section

open CategoryTheory TopologicalSpace

namespace BasedTopCat

/-- The based continuous identity from refinement of the original target to the
original target, followed by direct lifts to a common carrier universe. -/
def compactlyGeneratedCounitULift.{p, w, u} (Y : Type u)
    [tY : TopologicalSpace Y] (y : Y) :
    @ofULift.{max w u} Y (compactlyGenerated.{p} Y) y ⟶
      ofULift.{max w u} Y y :=
  @ofHomULift.{w, u, u} Y Y (compactlyGenerated.{p} Y) tY y y
    (ContinuousMap.compactlyGeneratedCounit.{p} Y) rfl

/-- The based counit leaves every lifted point unchanged. -/
@[simp]
theorem compactlyGeneratedCounitULift_apply.{p, w, u} (Y : Type u)
    [TopologicalSpace Y] (y : Y) (a : ULift.{max w u} Y) :
    (compactlyGeneratedCounitULift.{p, w} Y y).right.hom a = a := rfl

/-- In particular, the based counit preserves the lift of the original selected point. -/
theorem compactlyGeneratedCounitULift_apply_point.{p, w, u} (Y : Type u)
    [TopologicalSpace Y] (y : Y) :
    (compactlyGeneratedCounitULift.{p, w} Y y).right.hom (ULift.up y) =
      ULift.up y := rfl

/-- Lift an original continuous based map into refinement of the original target,
then lift both carriers directly. Only the original source is required to be
generated by the fixed probe universe. -/
def toCompactlyGeneratedULift.{p, w, u, v} {Z : Type u} {Y : Type v}
    [tZ : TopologicalSpace Z] [tY : TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] {z : Z} {y : Y}
    (f : C(Z, Y)) (h : f z = y) :
    ofULift.{max w u v} Z z ⟶
      @ofULift.{max w u v} Y (compactlyGenerated.{p} Y) y :=
  @ofHomULift.{w, u, v} Z Y tZ (compactlyGenerated.{p} Y) z y
    (ContinuousMap.toCompactlyGenerated.{p} f) h

/-- Evaluation of a lifted original representative is ordinary up/down transport. -/
@[simp]
theorem toCompactlyGeneratedULift_apply.{p, w, u, v} {Z : Type u} {Y : Type v}
    [TopologicalSpace Z] [TopologicalSpace Y] [UCompactlyGeneratedSpace.{p} Z]
    {z : Z} {y : Y} (f : C(Z, Y)) (h : f z = y) (a : ULift.{max w u v} Z) :
    (toCompactlyGeneratedULift.{p, w} f h).right.hom a =
      ULift.up (f a.down) := rfl

/-- The outward composite of a lifted original representative is its ordinary lift. -/
@[simp]
theorem toCompactlyGeneratedULift_comp_counit.{p, w, u, v}
    {Z : Type u} {Y : Type v} [TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] {z : Z} {y : Y}
    (f : C(Z, Y)) (h : f z = y) :
    toCompactlyGeneratedULift.{p, w} f h ≫
        compactlyGeneratedCounitULift.{p, max w u v} Y y =
      ofHomULift.{w} f h := by
  apply Under.UnderMorphism.ext
  apply TopCat.ext
  intro a
  rfl

/-- Lifting an outward composite recovers the direct lift of a map into the
refined original target. -/
@[simp]
theorem toCompactlyGeneratedULift_counit_comp.{p, w, u, v}
    {Z : Type u} {Y : Type v} [tZ : TopologicalSpace Z] [tY : TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] {z : Z} {y : Y}
    (f : @ContinuousMap Z Y tZ (compactlyGenerated.{p} Y)) (h : f z = y) :
    toCompactlyGeneratedULift.{p, w}
        (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) tY
          (ContinuousMap.compactlyGeneratedCounit.{p} Y) f) h =
      @ofHomULift.{w, u, v} Z Y tZ (compactlyGenerated.{p} Y) z y f h := by
  apply Under.UnderMorphism.ext
  apply TopCat.ext
  intro a
  rfl

/-- Postcomposition by the based counit on whole point-relative homotopy hom-sets.
The original source and target are lifted to one common carrier universe, while
the fixed probe universe is unchanged. -/
def compactlyGeneratedCounitPostcomp.{p, w, u, v} (Z : Type u) (Y : Type v)
    [TopologicalSpace Z] [TopologicalSpace Y] (z : Z) (y : Y) :
    (homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj
        (@ofULift.{max w u v} Y (compactlyGenerated.{p} Y) y)) →
    (homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj (ofULift.{max w u v} Y y)) :=
  homotopyPostcomp (ofULift.{max w u v} Z z)
    (compactlyGeneratedCounitULift.{p, max w u v} Y y)

/-- The counit class map is composition with the class of the canonical based counit. -/
@[simp]
theorem compactlyGeneratedCounitPostcomp_apply.{p, w, u, v}
    (Z : Type u) (Y : Type v) [TopologicalSpace Z] [TopologicalSpace Y]
    (z : Z) (y : Y)
    (q : homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj
        (@ofULift.{max w u v} Y (compactlyGenerated.{p} Y) y)) :
    compactlyGeneratedCounitPostcomp.{p, w} Z Y z y q =
      q ≫ homotopyQuotient.map
        (compactlyGeneratedCounitULift.{p, max w u v} Y y) := rfl

/-- On a based representative, the class map is the class of its outward composite. -/
theorem compactlyGeneratedCounitPostcomp_map.{p, w, u, v}
    (Z : Type u) (Y : Type v) [TopologicalSpace Z] [TopologicalSpace Y]
    (z : Z) (y : Y)
    (f : ofULift.{max w u v} Z z ⟶
      @ofULift.{max w u v} Y (compactlyGenerated.{p} Y) y) :
    compactlyGeneratedCounitPostcomp.{p, w} Z Y z y (homotopyQuotient.map f) =
      homotopyQuotient.map
        (f ≫ compactlyGeneratedCounitULift.{p, max w u v} Y y) := by
  exact (homotopyQuotient.map_comp f _).symm

/-- Lifting an original based map and then applying the counit class map recovers
its original class. This identifies the class construction on original representatives. -/
theorem compactlyGeneratedCounitPostcomp_toCompactlyGeneratedULift.{p, w, u, v}
    {Z : Type u} {Y : Type v} [TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] {z : Z} {y : Y}
    (f : C(Z, Y)) (h : f z = y) :
    compactlyGeneratedCounitPostcomp.{p, w} Z Y z y
        (homotopyQuotient.map (toCompactlyGeneratedULift.{p, w} f h)) =
      homotopyQuotient.map (ofHomULift.{w} f h) := by
  rw [compactlyGeneratedCounitPostcomp_map, toCompactlyGeneratedULift_comp_counit]

/-- On a directly lifted original map into the refined target, the counit class
map is the direct lift of the original outward composite. -/
theorem compactlyGeneratedCounitPostcomp_ofHomULift.{p, w, u, v}
    {Z : Type u} {Y : Type v} [tZ : TopologicalSpace Z] [tY : TopologicalSpace Y]
    {z : Z} {y : Y}
    (f : @ContinuousMap Z Y tZ (compactlyGenerated.{p} Y)) (h : f z = y) :
    compactlyGeneratedCounitPostcomp.{p, w} Z Y z y
        (homotopyQuotient.map
          (@ofHomULift.{w, u, v} Z Y tZ (compactlyGenerated.{p} Y) z y f h)) =
      homotopyQuotient.map
        (ofHomULift.{w}
          (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) tY
            (ContinuousMap.compactlyGeneratedCounit.{p} Y) f) h) := by
  exact @homotopyPostcomp_ofHomULift.{w, u, v, v}
    Z Y Y tZ (compactlyGenerated.{p} Y) tY z y y f
    (@ContinuousMap.compactlyGeneratedCounit.{p} Y tY) h rfl

/-- Postcomposition with the counit preserves and reflects joint homotopy
relative to the selected original source point. No closedness of that point or
separation condition on the target is required. -/
theorem homotopicRel_compactlyGeneratedCounit_iff.{p, u, v}
    (Z : Type u) (Y : Type v) [tZ : TopologicalSpace Z] [tY : TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] (z : Z)
    (f g : @ContinuousMap Z Y tZ (compactlyGenerated.{p} Y)) :
    @ContinuousMap.HomotopicRel Z Y tZ tY
        (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) tY
          (ContinuousMap.compactlyGeneratedCounit.{p} Y) f)
        (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) tY
          (ContinuousMap.compactlyGeneratedCounit.{p} Y) g) {z} ↔
      @ContinuousMap.HomotopicRel Z Y tZ (compactlyGenerated.{p} Y) f g {z} := by
  simpa only
      [@ContinuousMap.toCompactlyGenerated_comp_compactlyGeneratedCounit.{p}
        Z Y tZ tY inferInstance f,
       @ContinuousMap.toCompactlyGenerated_comp_compactlyGeneratedCounit.{p}
        Z Y tZ tY inferInstance g] using
    (@ContinuousMap.homotopicRel_toCompactlyGenerated_iff.{p}
      Z Y tZ tY inferInstance
      (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) tY
        (ContinuousMap.compactlyGeneratedCounit.{p} Y) f)
      (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) tY
        (ContinuousMap.compactlyGeneratedCounit.{p} Y) g) {z}).symm

/-- The canonical counit is bijective on whole point-relative based-homotopy
hom-sets from an original source generated by the fixed probe universe. -/
theorem bijective_compactlyGeneratedCounitPostcomp.{p, w, u, v}
    (Z : Type u) (Y : Type v) [tZ : TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] (z : Z) (y : Y) :
    Function.Bijective (compactlyGeneratedCounitPostcomp.{p, w} Z Y z y) := by
  constructor
  · intro q r h
    obtain ⟨f, hf, rfl⟩ :=
      @exists_homotopyQuotient_map_ofHomULift_eq.{w} Z Y tZ
        (compactlyGenerated.{p} Y) z y q
    obtain ⟨g, hg, rfl⟩ :=
      @exists_homotopyQuotient_map_ofHomULift_eq.{w} Z Y tZ
        (compactlyGenerated.{p} Y) z y r
    have h' :=
      (@compactlyGeneratedCounitPostcomp_ofHomULift.{p, w, u, v}
        Z Y tZ inferInstance z y f hf).symm.trans
        (h.trans (@compactlyGeneratedCounitPostcomp_ofHomULift.{p, w, u, v}
          Z Y tZ inferInstance z y g hg))
    apply (@homotopyQuotient_map_ofHomULift_eq_iff.{w} Z Y tZ
      (compactlyGenerated.{p} Y) z y f g hf hg).2
    exact (@homotopicRel_compactlyGeneratedCounit_iff.{p}
      Z Y tZ inferInstance inferInstance z f g).1
      ((@homotopyQuotient_map_ofHomULift_eq_iff.{w}
        Z Y tZ inferInstance z y
        (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) inferInstance
          (ContinuousMap.compactlyGeneratedCounit.{p} Y) f)
        (@ContinuousMap.comp Z Y Y tZ (compactlyGenerated.{p} Y) inferInstance
          (ContinuousMap.compactlyGeneratedCounit.{p} Y) g) hf hg).1 h')
  · intro q
    obtain ⟨f, hf, rfl⟩ := exists_homotopyQuotient_map_ofHomULift_eq.{w} Z Y z y q
    exact ⟨homotopyQuotient.map (toCompactlyGeneratedULift.{p, w} f hf),
      compactlyGeneratedCounitPostcomp_toCompactlyGeneratedULift.{p, w} f hf⟩

/-- The counit equivalence on whole based-homotopy hom-sets. Refinement is applied
to the original target before direct universe lifting. Only the original source
is required to be generated by the fixed probe universe. -/
noncomputable def compactlyGeneratedCounitEquiv.{p, w, u, v}
    (Z : Type u) (Y : Type v) [TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] (z : Z) (y : Y) :
    (homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj
        (@ofULift.{max w u v} Y (compactlyGenerated.{p} Y) y)) ≃
    (homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj (ofULift.{max w u v} Y y)) :=
  Equiv.ofBijective (compactlyGeneratedCounitPostcomp.{p, w} Z Y z y)
    (bijective_compactlyGeneratedCounitPostcomp.{p, w} Z Y z y)

/-- The forward equivalence is the canonical counit on every class. -/
@[simp]
theorem compactlyGeneratedCounitEquiv_apply.{p, w, u, v}
    (Z : Type u) (Y : Type v) [TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] (z : Z) (y : Y)
    (q : homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj
        (@ofULift.{max w u v} Y (compactlyGenerated.{p} Y) y)) :
    compactlyGeneratedCounitEquiv.{p, w} Z Y z y q =
      compactlyGeneratedCounitPostcomp.{p, w} Z Y z y q := rfl

/-- On every original continuous based representative, the inverse equivalence
is the class of its lift into the refined original target. -/
@[simp]
theorem compactlyGeneratedCounitEquiv_symm_apply_map_ofHomULift.{p, w, u, v}
    {Z : Type u} {Y : Type v} [TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] {z : Z} {y : Y}
    (f : C(Z, Y)) (h : f z = y) :
    (compactlyGeneratedCounitEquiv.{p, w} Z Y z y).symm
        (homotopyQuotient.map (ofHomULift.{w} f h)) =
      homotopyQuotient.map (toCompactlyGeneratedULift.{p, w} f h) := by
  apply (Equiv.symm_apply_eq _).2
  exact (compactlyGeneratedCounitPostcomp_toCompactlyGeneratedULift.{p, w} f h).symm

/-- The counit sends the inverse comparison of every class back to that class. -/
theorem compactlyGeneratedCounitPostcomp_equiv_symm_apply.{p, w, u, v}
    (Z : Type u) (Y : Type v) [TopologicalSpace Z] [TopologicalSpace Y]
    [UCompactlyGeneratedSpace.{p} Z] (z : Z) (y : Y)
    (q : homotopyQuotient.obj (ofULift.{max w u v} Z z) ⟶
      homotopyQuotient.obj (ofULift.{max w u v} Y y)) :
    compactlyGeneratedCounitPostcomp.{p, w} Z Y z y
        ((compactlyGeneratedCounitEquiv.{p, w} Z Y z y).symm q) = q :=
  (compactlyGeneratedCounitEquiv.{p, w} Z Y z y).apply_symm_apply q

/-- Directly lifted counits commute with every original based continuous map.
Neither original space needs to be compactly generated. -/
theorem compactlyGeneratedCounitULift_naturality.{p, w, u, v}
    {Y : Type u} {T : Type v} [TopologicalSpace Y] [TopologicalSpace T]
    {y : Y} {t : T} (g : C(Y, T)) (hg : g y = t) :
    @ofHomULift.{w, u, v} Y T
        (compactlyGenerated.{p} Y) (compactlyGenerated.{p} T) y t
        (ContinuousMap.compactlyGeneratedMap.{p} g) hg ≫
        compactlyGeneratedCounitULift.{p, max w u v} T t =
      compactlyGeneratedCounitULift.{p, max w u v} Y y ≫ ofHomULift.{w} g hg := by
  apply Under.UnderMorphism.ext
  apply TopCat.ext
  intro a
  exact congrArg ULift.up
    (DFunLike.congr_fun (ContinuousMap.compactlyGeneratedCounit_naturality.{p} g) a.down)

/-- The counit class comparison is contravariantly natural in arbitrary original
source maps and covariantly natural in arbitrary original target maps. No
compact-generation hypothesis is needed for this forward square. -/
theorem compactlyGeneratedCounitPostcomp_naturality.{p, w, a, b, c, d}
    (S : Type a) (Z : Type b) (Y : Type c) (T : Type d)
    [TopologicalSpace S] [TopologicalSpace Z]
    [TopologicalSpace Y] [TopologicalSpace T]
    (s : S) (z : Z) (y : Y) (t : T)
    (f : C(S, Z)) (g : C(Y, T)) (hf : f s = z) (hg : g y = t)
    (q : homotopyQuotient.obj (ofULift.{max w a b c d} Z z) ⟶
      homotopyQuotient.obj
        (@ofULift.{max w a b c d} Y (compactlyGenerated.{p} Y) y)) :
    compactlyGeneratedCounitPostcomp.{p, max w a b c d} S T s t
        (homotopyQuotient.map (ofHomULift.{max w a b c d} f hf) ≫ q ≫
          homotopyQuotient.map
            (@ofHomULift.{max w a b c d} Y T
              (compactlyGenerated.{p} Y) (compactlyGenerated.{p} T) y t
              (ContinuousMap.compactlyGeneratedMap.{p} g) hg)) =
      homotopyQuotient.map (ofHomULift.{max w a b c d} f hf) ≫
        compactlyGeneratedCounitPostcomp.{p, max w a b c d} Z Y z y q ≫
        homotopyQuotient.map (ofHomULift.{max w a b c d} g hg) := by
  simp only [compactlyGeneratedCounitPostcomp_apply, Category.assoc]
  rw [← homotopyQuotient.map_comp, compactlyGeneratedCounitULift_naturality,
    homotopyQuotient.map_comp]

/-- The inverse counit comparison is natural under based precomposition and
postcomposition. Only the two original source spaces require generation by the
fixed probe universe; both original targets remain arbitrary. -/
theorem compactlyGeneratedCounitEquiv_symm_naturality.{p, w, a, b, c, d}
    (S : Type a) (Z : Type b) (Y : Type c) (T : Type d)
    [TopologicalSpace S] [TopologicalSpace Z]
    [TopologicalSpace Y] [TopologicalSpace T]
    [UCompactlyGeneratedSpace.{p} S] [UCompactlyGeneratedSpace.{p} Z]
    (s : S) (z : Z) (y : Y) (t : T)
    (f : C(S, Z)) (g : C(Y, T)) (hf : f s = z) (hg : g y = t)
    (q : homotopyQuotient.obj (ofULift.{max w a b c d} Z z) ⟶
      homotopyQuotient.obj (ofULift.{max w a b c d} Y y)) :
    (compactlyGeneratedCounitEquiv.{p, max w a b c d} S T s t).symm
        (homotopyQuotient.map (ofHomULift.{max w a b c d} f hf) ≫ q ≫
          homotopyQuotient.map (ofHomULift.{max w a b c d} g hg)) =
      homotopyQuotient.map (ofHomULift.{max w a b c d} f hf) ≫
        (compactlyGeneratedCounitEquiv.{p, max w a b c d} Z Y z y).symm q ≫
        homotopyQuotient.map
          (@ofHomULift.{max w a b c d} Y T
            (compactlyGenerated.{p} Y) (compactlyGenerated.{p} T) y t
            (ContinuousMap.compactlyGeneratedMap.{p} g) hg) := by
  apply (compactlyGeneratedCounitEquiv.{p, max w a b c d} S T s t).injective
  rw [Equiv.apply_symm_apply, compactlyGeneratedCounitEquiv_apply,
    compactlyGeneratedCounitPostcomp_naturality,
    compactlyGeneratedCounitPostcomp_equiv_symm_apply]

end BasedTopCat
